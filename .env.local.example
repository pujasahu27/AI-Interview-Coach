# --- Client-side Firebase config (safe to expose, NEXT_PUBLIC_*) ---
# Firebase Console -> Project settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-only Firebase Admin SDK credentials ---
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key as a single line with \n escapes preserved, e.g.:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Session cookie ---
SESSION_COOKIE_MAX_AGE_DAYS=5

# --- Gemini API (free-tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Razorpay (paywall top-ups) ---
# Dashboard -> Settings -> API Keys. Use test mode keys until you're ready to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> add endpoint {your-domain}/api/payments/webhook,
# subscribe to "payment.captured", then paste its signing secret here.
RAZORPAY_WEBHOOK_SECRET=
